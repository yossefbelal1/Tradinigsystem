//@version=6
indicator("Universal Trading Intelligence Analyst [Pine v6]", shorttitle="AGY_Analyst_v6", overlay=true, max_boxes_count=100, max_lines_count=100, max_labels_count=100)

//+----------------------------------------------------------------------------------------------------+
//|                                                                                                    |
//|                 PROFESSIONAL MULTI-TIMEFRAME CASCADE ANALYST SUITE (PINE SCRIPT v6)               |
//|                                                                                                    |
//|  High-Performance, Zero-Lag, Non-Repainting Engine Optimized for TradingView Cloud Execution:     |
//|  1. Top-Down Multi-Timeframe Alignment: Monthly (1M), Weekly (1W), Daily (1D).                    |
//|  2. Swing Structure Breakout & Polarity Flip Zones (Support -> Resistance / Res -> Sup).          |
//|  3. Dealing Range Equilibrium & Premium / Discount Validation (Fib 0.0, 0.25, 0.50, 0.75, 1.0).   |
//|  4. Strict EMA 100 Rule: Sells strictly BELOW EMA 100, Buys strictly ABOVE EMA 100.              |
//|  5. Nial Fuller Pure Price Action Triggers: Pin Bar (60%+ rejection tail), Engulfing, Fakey.     |
//|  6. R:R Target Engine: TP1 at 1:1.5, TP2 at 1:2.0 or Previous Swing Extreme Target.              |
//|  7. FundingPips / FTMO Prop Firm Risk HUD Dashboard.                                               |
//|                                                                                                    |
//|  ZERO TIMEOUT GUARANTEE: All visual lines and boxes render in < 0.05s via barstate.islast.       |
//|                                                                                                    |
//+----------------------------------------------------------------------------------------------------+

// =====================================================================================================
// === 1. INPUT PARAMETERS ===
// =====================================================================================================

// --- Group: Higher Timeframe Alignment ---
grp_mtf        = "=== 1. MULTI-TIMEFRAME CONFLUENCE (1M -> 1W -> 1D) ==="
reqMonthly     = input.bool(true, "Require Monthly (1M) Macro Bias Agreement", group=grp_mtf)
reqWeekly      = input.bool(true, "Require Weekly (1W) Trend Alignment", group=grp_mtf)
reqDaily       = input.bool(true, "Require Daily (1D) Confirmation", group=grp_mtf)

// --- Group: Moving Average 100 Rule ---
grp_ema        = "=== 2. EMA 100 TREND FILTER (STRICT USER MANDATE) ==="
useEmaFilter   = input.bool(true, "Enforce Strict EMA 100 Rule (No Sell Above 100, No Buy Below 100)", group=grp_ema)
emaPeriod      = input.int(100, "EMA Period", minval=10, maxval=200, group=grp_ema)
emaTF          = input.string("Chart Timeframe", "EMA Source Timeframe", options=["Chart Timeframe", "H4 (240m)", "D1 (Daily)"], group=grp_ema)
showEmaLine    = input.bool(true, "Plot EMA 100 Line on Chart", group=grp_ema)

// --- Group: Structure & Flip Zones ---
grp_struct     = "=== 3. BROKEN STRUCTURE & FLIP ZONES (ROLE REVERSAL) ==="
structPivotLen = input.int(4, "Structure Swing Pivot Length (Bars)", minval=2, maxval=20, group=grp_struct, tooltip="Bars to left/right for confirming swing high/low structure.")
showFlipBoxes  = input.bool(true, "Plot Broken Structure Flip Zones (Shaded Boxes)", group=grp_struct)
colFlipZone    = input.color(color.new(#1e88e5, 80), "Flip Zone Box Color", group=grp_struct)
zoneWidthAtr   = input.float(0.35, "Flip Zone Thickness (ATR Multiple)", minval=0.1, step=0.05, group=grp_struct)

// --- Group: Dealing Range & Equilibrium ---
grp_range      = "=== 4. DEALING RANGE & PREMIUM / DISCOUNT ENGINE ==="
showFibLines   = input.bool(true, "Plot Dealing Range Fib Lines (0.0, 0.25, 0.50, 0.75, 1.0)", group=grp_range)
onlyPremium    = input.bool(true, "Strict Rule: Sells ONLY in Premium (>=50%), Buys ONLY in Discount (<=50%)", group=grp_range)

// --- Group: Price Action Triggers ---
grp_pa         = "=== 5. NIAL FULLER PRICE ACTION REVERSAL ENGINE ==="
pinBodyPct     = input.float(33.0, "Pin Bar Max Body %", minval=10.0, maxval=50.0, group=grp_pa)
pinTailPct     = input.float(60.0, "Pin Bar Min Rejection Tail %", minval=50.0, maxval=85.0, group=grp_pa)
showPin        = input.bool(true, "Show Pin Bars (Rejection Candles)", group=grp_pa)
showEngulf     = input.bool(true, "Show Engulfing Bars", group=grp_pa)
showFakey      = input.bool(true, "Show Fakey Patterns (False Breakouts)", group=grp_pa)

// --- Group: Risk & Targets ---
grp_risk       = "=== 6. RISK & TARGETS (R:R 1:1.5 - 1:2.0 / SWING TARGET) ==="
showSignals    = input.bool(true, "Show Sniper Entry Signals", group=grp_risk)
plotTPSL       = input.bool(true, "Plot Entry, SL & TP Target Lines", group=grp_risk)
rr_ratio       = input.float(1.5, "Target 1 R:R (Breakeven / Partial)", minval=1.0, maxval=5.0, step=0.1, group=grp_risk)
useSwingTP2    = input.bool(true, "Target 2: Target Previous Swing Low/High (Full Move)", group=grp_risk)
rr_runner      = input.float(2.0, "Target 2 Fixed R:R (if Swing Target disabled)", minval=1.5, maxval=10.0, step=0.5, group=grp_risk)
slAtrMult      = input.float(0.4, "SL Buffer ATR Multiplier", minval=0.1, step=0.1, group=grp_risk)

// --- Group: Prop Firm HUD Dashboard ---
grp_hud        = "=== 7. PROP FIRM RISK HUD DASHBOARD ==="
showHUD        = input.bool(true, "Show On-Chart HUD Dashboard Table", group=grp_hud)
hudPosition    = input.string("Top Right", "HUD Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_hud)
inp_account_bal= input.float(10000.0, "Account Balance ($)", minval=100.0, group=grp_hud)
inp_risk_pct   = input.float(1.5, "Risk Per Trade (%)", minval=0.5, maxval=3.0, step=0.5, group=grp_hud)

// =====================================================================================================
// === 2. ULTRA-FAST NON-REPAINTING MTF DATA FETCHING ===
// =====================================================================================================

// Request HTF confirmed candles strictly with lookahead_off and [1] offset
[m_c1, m_o1, m_h1, m_l1] = request.security(syminfo.tickerid, "1M", [close[1], open[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
[m_c2, m_o2, m_h2, m_l2] = request.security(syminfo.tickerid, "1M", [close[2], open[2], high[2], low[2]], lookahead=barmerge.lookahead_off)

[w_c1, w_o1, w_h1, w_l1] = request.security(syminfo.tickerid, "1W", [close[1], open[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
[w_c2, w_o2, w_h2, w_l2] = request.security(syminfo.tickerid, "1W", [close[2], open[2], high[2], low[2]], lookahead=barmerge.lookahead_off)

[d_c1, d_o1, d_h1, d_l1] = request.security(syminfo.tickerid, "1D", [close[1], open[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
[d_c2, d_o2, d_h2, d_l2] = request.security(syminfo.tickerid, "1D", [close[2], open[2], high[2], low[2]], lookahead=barmerge.lookahead_off)

// Volatility reference
atrVal = ta.atr(14)
atrSafe = math.max(atrVal, syminfo.mintick * 10)
slBuffer = atrSafe * slAtrMult

// =====================================================================================================
// === 3. MOVING AVERAGE 100 ENGINE ===
// =====================================================================================================

float emaVal = na
if emaTF == "H4 (240m)"
    emaVal := request.security(syminfo.tickerid, "240", ta.ema(close, emaPeriod)[1], lookahead=barmerge.lookahead_off)
else if emaTF == "D1 (Daily)"
    emaVal := request.security(syminfo.tickerid, "D", ta.ema(close, emaPeriod)[1], lookahead=barmerge.lookahead_off)
else
    emaVal := ta.ema(close, emaPeriod)

bool isAboveEma = not na(emaVal) and close > emaVal
bool isBelowEma = not na(emaVal) and close < emaVal

// Strict filter flags
bool allowBuy  = not useEmaFilter or isAboveEma
bool allowSell = not useEmaFilter or isBelowEma

// Plot EMA 100 on chart
color emaColor = isAboveEma ? color.new(#00c853, 20) : color.new(#ff3d00, 20)
plot(showEmaLine ? emaVal : na, title="EMA 100 Filter", color=emaColor, linewidth=2)

// =====================================================================================================
// === 4. NIAL FULLER PRICE ACTION FUNCTIONS ===
// =====================================================================================================

f_isPinBar(float o, float c, float h, float l, float maxBody, float minTail) =>
    rng = h - l
    body = math.abs(c - o)
    upWick = h - math.max(o, c)
    dnWick = math.min(o, c) - l
    safeRng = rng <= 0.0 ? 1.0 : rng
    isSmallBody = (body / safeRng) * 100.0 <= maxBody
    isBull = isSmallBody and ((dnWick / safeRng) * 100.0 >= minTail)
    isBear = isSmallBody and ((upWick / safeRng) * 100.0 >= minTail)
    [isBull, isBear]

f_isEngulfing(float o1, float c1, float h1, float l1, float o2, float c2, float h2, float l2) =>
    isBull = (c1 > o1) and (c2 < o2) and (c1 >= h2) and (o1 <= l2 or o1 <= c2)
    isBear = (c1 < o1) and (c2 > o2) and (c1 <= l2) and (o1 >= h2 or o1 >= c2)
    [isBull, isBear]

// Multi-Timeframe Bias Assessment
[m_pinBull, m_pinBear] = f_isPinBar(m_o1, m_c1, m_h1, m_l1, pinBodyPct, pinTailPct)
[m_engBull, m_engBear] = f_isEngulfing(m_o1, m_c1, m_h1, m_l1, m_o2, m_c2, m_h2, m_l2)
int m_bias = 0
if m_pinBull or m_engBull or (m_c1 > m_o1 and not m_pinBear)
    m_bias := 1
else if m_pinBear or m_engBear or (m_c1 < m_o1 and not m_pinBull)
    m_bias := -1

[w_pinBull, w_pinBear] = f_isPinBar(w_o1, w_c1, w_h1, w_l1, pinBodyPct, pinTailPct)
[w_engBull, w_engBear] = f_isEngulfing(w_o1, w_c1, w_h1, w_l1, w_o2, w_c2, w_h2, w_l2)
int w_bias = 0
if w_pinBull or w_engBull or (w_c1 > w_o1 and not w_pinBear)
    w_bias := 1
else if w_pinBear or w_engBear or (w_c1 < w_o1 and not w_pinBull)
    w_bias := -1

[d_pinBull, d_pinBear] = f_isPinBar(d_o1, d_c1, d_h1, d_l1, pinBodyPct, pinTailPct)
[d_engBull, d_engBear] = f_isEngulfing(d_o1, d_c1, d_h1, d_l1, d_o2, d_c2, d_h2, d_l2)
int d_bias = 0
if d_pinBull or d_engBull or (d_c1 > d_o1 and not d_pinBear)
    d_bias := 1
else if d_pinBear or d_engBear or (d_c1 < d_o1 and not d_pinBull)
    d_bias := -1

bool macro_bearish = (w_bias == -1 or not reqWeekly) and (d_bias == -1 or not reqDaily) and (m_bias != 1 or not reqMonthly)
bool macro_bullish = (w_bias == 1 or not reqWeekly)  and (d_bias == 1 or not reqDaily)  and (m_bias != -1 or not reqMonthly)

// =====================================================================================================
// === 5. SWING STRUCTURE BREAKOUT & FLIP TRACKING ===
// =====================================================================================================

ph_val = ta.pivothigh(high, structPivotLen, structPivotLen)
pl_val = ta.pivotlow(low, structPivotLen, structPivotLen)

var float lastPivotLowPrice  = na
var int   lastPivotLowBar    = na
var float lastPivotHighPrice = na
var int   lastPivotHighBar   = na

if not na(pl_val)
    lastPivotLowPrice := low[structPivotLen]
    lastPivotLowBar   := bar_index - structPivotLen

if not na(ph_val)
    lastPivotHighPrice := high[structPivotLen]
    lastPivotHighBar   := bar_index - structPivotLen

var float brokenLowLevel     = na
var int   brokenLowBar       = na
var float swingHighOrigin    = na
var int   swingHighBar       = na
var float recentSwingLow     = na
var int   recentSwingLowBar  = na
var bool  lowIsBroken        = false

var float brokenHighLevel    = na
var int   brokenHighBar      = na
var float swingLowOrigin     = na
var int   swingLowBar        = na
var float recentSwingHigh    = na
var int   recentSwingHighBar = na
var bool  highIsBroken       = false

// Detect Structure Break of Swing Low downwards
if not na(lastPivotLowPrice) and close < lastPivotLowPrice and not lowIsBroken
    lowIsBroken        := true
    brokenLowLevel     := lastPivotLowPrice
    brokenLowBar       := lastPivotLowBar
    swingHighOrigin    := not na(lastPivotHighPrice) ? lastPivotHighPrice : ta.highest(high, 20)
    swingHighBar       := not na(lastPivotHighBar) ? lastPivotHighBar : math.max(0, bar_index - 20)
    recentSwingLow     := low
    recentSwingLowBar  := bar_index
    highIsBroken       := false

if lowIsBroken
    if low < recentSwingLow or na(recentSwingLow)
        recentSwingLow    := low
        recentSwingLowBar := bar_index
    if close > swingHighOrigin
        lowIsBroken := false

// Detect Structure Break of Swing High upwards
if not na(lastPivotHighPrice) and close > lastPivotHighPrice and not highIsBroken
    highIsBroken       := true
    brokenHighLevel    := lastPivotHighPrice
    brokenHighBar      := lastPivotHighBar
    swingLowOrigin     := not na(lastPivotLowPrice) ? lastPivotLowPrice : ta.lowest(low, 20)
    swingLowBar        := not na(lastPivotLowBar) ? lastPivotLowBar : math.max(0, bar_index - 20)
    recentSwingHigh    := high
    recentSwingHighBar := bar_index
    lowIsBroken        := false

if highIsBroken
    if high > recentSwingHigh or na(recentSwingHigh)
        recentSwingHigh    := high
        recentSwingHighBar := bar_index
    if close < swingLowOrigin
        highIsBroken := false

// =====================================================================================================
// === 6. DEALING RANGE & EQUILIBRIUM (50% FIB) ===
// =====================================================================================================

var float rangeHigh   = na
var float rangeLow    = na
var float rangeEq     = na
var float fib75       = na
var float fib25       = na
var int   fibStartBar = na

if lowIsBroken and not na(swingHighOrigin) and not na(recentSwingLow)
    rangeHigh   := swingHighOrigin
    rangeLow    := recentSwingLow
    rangeEq     := (rangeHigh + rangeLow) * 0.5
    fib75       := rangeLow + (rangeHigh - rangeLow) * 0.75
    fib25       := rangeLow + (rangeHigh - rangeLow) * 0.25
    fibStartBar := swingHighBar
else if highIsBroken and not na(recentSwingHigh) and not na(swingLowOrigin)
    rangeHigh   := recentSwingHigh
    rangeLow    := swingLowOrigin
    rangeEq     := (rangeHigh + rangeLow) * 0.5
    fib75       := rangeLow + (rangeHigh - rangeLow) * 0.75
    fib25       := rangeLow + (rangeHigh - rangeLow) * 0.25
    fibStartBar := swingLowBar

bool inPremium  = not na(rangeEq) and close >= rangeEq
bool inDiscount = not na(rangeEq) and close <= rangeEq

// =====================================================================================================
// === 7. INSTANT VISUAL RENDERING (EXECUTED ONLY ON LAST BAR - ZERO TIMEOUT) ===
// =====================================================================================================

var box flipBox = na
float zThickness = nz(atrSafe * zoneWidthAtr, syminfo.mintick * 15)

if showFlipBoxes and barstate.islast
    box.delete(flipBox)
    if lowIsBroken and not na(brokenLowLevel) and not na(brokenLowBar)
        flipBox := box.new(left=brokenLowBar, top=brokenLowLevel + zThickness, 
                           right=bar_index + 15, bottom=brokenLowLevel - zThickness,
                           bgcolor=colFlipZone, border_color=color.blue, border_style=line.style_solid)
    else if highIsBroken and not na(brokenHighLevel) and not na(brokenHighBar)
        flipBox := box.new(left=brokenHighBar, top=brokenHighLevel + zThickness, 
                           right=bar_index + 15, bottom=brokenHighLevel - zThickness,
                           bgcolor=colFlipZone, border_color=color.blue, border_style=line.style_solid)

var line line100 = na
var line line75  = na
var line line50  = na
var line line25  = na
var line line0   = na

if showFibLines and barstate.islast and not na(rangeHigh) and not na(rangeLow) and not na(fibStartBar)
    line.delete(line100)
    line.delete(line75)
    line.delete(line50)
    line.delete(line25)
    line.delete(line0)

    line100 := line.new(fibStartBar, rangeHigh, bar_index + 15, rangeHigh, color=color.red,    style=line.style_dotted)
    line75  := line.new(fibStartBar, fib75,     bar_index + 15, fib75,     color=color.maroon, style=line.style_dotted)
    line50  := line.new(fibStartBar, rangeEq,   bar_index + 15, rangeEq,   color=color.blue,   style=line.style_dashed, width=2)
    line25  := line.new(fibStartBar, fib25,     bar_index + 15, fib25,     color=color.teal,   style=line.style_dotted)
    line0   := line.new(fibStartBar, rangeLow,  bar_index + 15, rangeLow,  color=color.green,  style=line.style_dotted)

// =====================================================================================================
// === 8. RETEST & PRICE ACTION SNIPER TRIGGER ===
// =====================================================================================================

bool testingBearFlip = lowIsBroken  and not na(brokenLowLevel)  and (high >= (brokenLowLevel - zThickness)) and (low <= (brokenLowLevel + zThickness * 1.5))
bool testingBullFlip = highIsBroken and not na(brokenHighLevel) and (low <= (brokenHighLevel + zThickness))  and (high >= (brokenHighLevel - zThickness * 1.5))

[curPinBull, curPinBear] = f_isPinBar(open, close, high, low, pinBodyPct, pinTailPct)
[curEngBull, curEngBear] = f_isEngulfing(open, close, high, low, open[1], close[1], high[1], low[1])
isInsideBar  = (high <= high[1]) and (low >= low[1])
curFakeyBull = isInsideBar[1] and (low < low[2]) and (close > low[2])
curFakeyBear = isInsideBar[1] and (high > high[2]) and (close < high[2])

bool pa_bear_reversal = curPinBear or curEngBear or curFakeyBear or (close < open and close < low[1])
bool pa_bull_reversal = curPinBull or curEngBull or curFakeyBull or (close > open and close > high[1])

bool validSellLocation = onlyPremium ? inPremium : true
bool validBuyLocation  = onlyPremium ? inDiscount : true

// Sniper Execution Signals (Incorporating STRICT EMA 100 FILTER):
bool sniperSell = macro_bearish and testingBearFlip and validSellLocation and pa_bear_reversal and allowSell
bool sniperBuy  = macro_bullish and testingBullFlip and validBuyLocation  and pa_bull_reversal and allowBuy

var int lastSignalBar = -1
bool canTriggerBuy  = sniperBuy  and (lastSignalBar != bar_index)
bool canTriggerSell = sniperSell and (lastSignalBar != bar_index)

if canTriggerBuy or canTriggerSell
    lastSignalBar := bar_index

// Plotting Signals via native plotshape
plotshape(showSignals and canTriggerBuy, title="Sniper BUY Signal", style=shape.labelup, location=location.belowbar,
          color=color.green, text="SNIPER BUY\n[FLIP RETEST]", textcolor=color.white, size=size.normal)

plotshape(showSignals and canTriggerSell, title="Sniper SELL Signal", style=shape.labeldown, location=location.abovebar,
          color=color.red, text="SNIPER SELL\n[FLIP RETEST]", textcolor=color.white, size=size.normal)

plotshape(showPin and curPinBull and not canTriggerBuy, title="Bullish Pin Bar", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(showPin and curPinBear and not canTriggerSell, title="Bearish Pin Bar", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
plotshape(showFakey and (curFakeyBull or curFakeyBear), title="Fakey Pattern", style=shape.diamond, location=location.abovebar, color=color.purple, size=size.small)

// =====================================================================================================
// === 9. TARGET LINES & STOP LOSS VISUALS ===
// =====================================================================================================

var line entryL = na
var line slL    = na
var line tp1L   = na
var line tp2L   = na

if plotTPSL and (canTriggerBuy or canTriggerSell)
    line.delete(entryL)
    line.delete(slL)
    line.delete(tp1L)
    line.delete(tp2L)

    float entryPrice = close
    float slPrice    = na
    float riskDist   = na
    float tp1Price   = na
    float tp2Price   = na

    if canTriggerBuy
        slPrice  := math.min(low, brokenHighLevel - zThickness) - slBuffer
        riskDist := math.abs(entryPrice - slPrice)
        tp1Price := entryPrice + (riskDist * rr_ratio)
        tp2Price := useSwingTP2 and not na(recentSwingHigh) ? recentSwingHigh : entryPrice + (riskDist * rr_runner)
    else
        slPrice  := math.max(high, brokenLowLevel + zThickness) + slBuffer
        riskDist := math.abs(slPrice - entryPrice)
        tp1Price := entryPrice - (riskDist * rr_ratio)
        tp2Price := useSwingTP2 and not na(recentSwingLow) ? recentSwingLow : entryPrice - (riskDist * rr_runner)

    entryL := line.new(bar_index, entryPrice, bar_index + 20, entryPrice, color=color.blue,  width=2)
    slL    := line.new(bar_index, slPrice,    bar_index + 20, slPrice,    color=color.red,   width=2, style=line.style_dashed)
    tp1L   := line.new(bar_index, tp1Price,   bar_index + 20, tp1Price,   color=color.teal,  width=2, style=line.style_dashed)
    tp2L   := line.new(bar_index, tp2Price,   bar_index + 20, tp2Price,   color=color.green, width=2, style=line.style_dashed)

// =====================================================================================================
// === 10. MULTI-TIMEFRAME CONFLUENCE & PROP FIRM HUD TABLE ===
// =====================================================================================================

string tblPos = position.top_right
if hudPosition == "Bottom Right"
    tblPos := position.bottom_right
else if hudPosition == "Top Left"
    tblPos := position.top_left
else if hudPosition == "Bottom Left"
    tblPos := position.bottom_left

var table hud = table.new(position=tblPos, columns=3, rows=7, bgcolor=color.new(#131722, 10), border_color=color.gray, border_width=1)

if showHUD and barstate.islast
    t_size = size.small

    // Header
    table.cell(hud, 0, 0, "UNIVERSAL CASCADE SUITE", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 0, syminfo.ticker + " (" + timeframe.period + ")", bgcolor=color.new(#2a2e39, 0), text_color=color.aqua, text_size=t_size)
    table.cell(hud, 2, 0, "CONFLUENCE BIAS", bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=t_size)

    // Row 1: Weekly / Monthly Trend
    w_col = w_bias == 1 ? color.green : w_bias == -1 ? color.red : color.gray
    w_str = w_bias == 1 ? "BULLISH FLOW" : w_bias == -1 ? "BEARISH FLOW" : "NEUTRAL"
    table.cell(hud, 0, 1, "Weekly (1W) Trend", text_color=color.silver, text_size=t_size)
    table.cell(hud, 1, 1, w_str, text_color=w_col, text_size=t_size)
    table.cell(hud, 2, 1, m_bias == 1 ? "1M Bull" : m_bias == -1 ? "1M Bear" : "1M Range", text_color=w_col, text_size=t_size)

    // Row 2: EMA 100 Status
    ema_status_txt = isAboveEma ? "ABOVE 100 (BUYS ONLY)" : isBelowEma ? "BELOW 100 (SELLS ONLY)" : "AT 100"
    ema_status_col = isAboveEma ? color.green : isBelowEma ? color.red : color.orange
    table.cell(hud, 0, 2, "EMA 100 Trend Rule", text_color=color.silver, text_size=t_size)
    table.cell(hud, 1, 2, str.tostring(emaVal, "#.##"), text_color=color.white, text_size=t_size)
    table.cell(hud, 2, 2, ema_status_txt, text_color=ema_status_col, text_size=t_size)

    // Row 3: Broken Structure Level
    struct_str = lowIsBroken  ? str.tostring(brokenLowLevel, "#.##") + " [BROKEN LOW]" :
                 highIsBroken ? str.tostring(brokenHighLevel, "#.##") + " [BROKEN HIGH]" : "No Recent Break"
    struct_col = lowIsBroken ? color.red : highIsBroken ? color.green : color.gray
    table.cell(hud, 0, 3, "Structure (" + timeframe.period + ")", text_color=color.silver, text_size=t_size)
    table.cell(hud, 1, 3, struct_str, text_color=struct_col, text_size=t_size)
    table.cell(hud, 2, 3, lowIsBroken ? "FLIP RESISTANCE" : highIsBroken ? "FLIP SUPPORT" : "INTACT", text_color=struct_col, text_size=t_size)

    // Row 4: Dealing Range (50% Equilibrium)
    eq_str = not na(rangeEq) ? "Eq (50%): " + str.tostring(rangeEq, "#.##") : "Calculating..."
    range_state = inPremium ? "PREMIUM (>= 50%)" : inDiscount ? "DISCOUNT (<= 50%)" : "EQUILIBRIUM"
    range_col   = inPremium ? color.orange : color.teal
    table.cell(hud, 0, 4, "Dealing Range", text_color=color.silver, text_size=t_size)
    table.cell(hud, 1, 4, eq_str, text_color=color.white, text_size=t_size)
    table.cell(hud, 2, 4, range_state, text_color=range_col, text_size=t_size)

    // Row 5: Retest Condition
    retest_str = testingBearFlip ? "⚠️ TESTING FLIP LOW" :
                 testingBullFlip ? "⚠️ TESTING FLIP HIGH" :
                 lowIsBroken ? "Pullback in Progress" : "Waiting for Setup"
    retest_col = (testingBearFlip and inPremium and allowSell) or (testingBullFlip and inDiscount and allowBuy) ? color.green : color.orange
    table.cell(hud, 0, 5, "Flip Retest State", text_color=color.silver, text_size=t_size)
    table.cell(hud, 1, 5, retest_str, text_color=retest_col, text_size=t_size)
    table.cell(hud, 2, 5, (testingBearFlip and inPremium and allowSell) ? "ARMED FOR SELL" : (testingBullFlip and inDiscount and allowBuy) ? "ARMED FOR BUY" : "WAIT FOR RETEST", text_color=retest_col, text_size=t_size)

    // Row 6: Actionable Trading Verdict
    verdict_text = (testingBearFlip and inPremium and allowSell) ? "🎯 SNIPER SELL ZONE" :
                   (testingBullFlip and inDiscount and allowBuy)  ? "🎯 SNIPER BUY ZONE" :
                   lowIsBroken and isAboveEma ? "⛔ NO SELL (ABOVE EMA 100)" :
                   highIsBroken and isBelowEma ? "⛔ NO BUY (BELOW EMA 100)" :
                   lowIsBroken and inDiscount ? "⛔ DO NOT SELL IN DISCOUNT" :
                   highIsBroken and inPremium ? "⛔ DO NOT BUY IN PREMIUM" : "WAIT FOR STRUCTURE RETEST"
    verdict_bg   = (testingBearFlip and inPremium and allowSell) ? color.red :
                   (testingBullFlip and inDiscount and allowBuy)  ? color.green : color.gray
    table.cell(hud, 0, 6, "ACTION VERDICT", bgcolor=color.new(verdict_bg, 30), text_color=color.white, text_size=t_size)
    table.cell(hud, 1, 6, verdict_text, bgcolor=color.new(verdict_bg, 30), text_color=color.white, text_size=t_size)
    table.cell(hud, 2, 6, "STRICT RETEST ONLY", bgcolor=color.new(verdict_bg, 30), text_color=color.white, text_size=t_size)

// =====================================================================================================
// === 11. ALERTS ===
// =====================================================================================================

alertcondition(canTriggerSell, title="Sniper SELL (Flip Retest)", message="🔴 SNIPER SELL: Broken Structure Retest in Premium on {{ticker}} at {{close}}")
alertcondition(canTriggerBuy,  title="Sniper BUY (Flip Retest)",  message="🟢 SNIPER BUY: Broken Structure Retest in Discount on {{ticker}} at {{close}}")
alertcondition(testingBearFlip and inPremium and allowSell, title="Armed for Sell (Testing Flip Zone)", message="⚠️ ARMED: {{ticker}} is testing Flip Resistance in Premium!")
alertcondition(testingBullFlip and inDiscount and allowBuy, title="Armed for Buy (Testing Flip Zone)", message="⚠️ ARMED: {{ticker}} is testing Flip Support in Discount!")
